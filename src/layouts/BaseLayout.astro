---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MenuOverlay from '@/components/MenuOverlay.astro';
import BaseHead from '@/components/BaseHead.astro';
import { SITE } from '@/site.config';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  footer?: boolean;
}

const { title, description, image, footer = true } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="caption sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-onyx focus:px-4 focus:py-2 focus:text-paper"
    >
      Pular para o conteúdo
    </a>

    <Header />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <MenuOverlay />
  </body>
</html>
