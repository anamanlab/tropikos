---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro';
import AdaptiveGallery from '@/components/AdaptiveGallery.astro';
import { SITE } from '@/site.config';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const {
  title,
  subtitle,
  location,
  year,
  typology,
  scope,
  summary,
  cover,
  coverAlt,
  gallery,
  galleryAlt,
  video,
  poster,
  area,
  photography,
} = entry.data;
const { Content } = await render(entry);

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const position = all.findIndex((item) => item.id === entry.id);
const next = all[(position + 1) % all.length];
const indexLabel = String(position + 1).padStart(2, '0');
---

<BaseLayout title={title} description={summary} image={cover?.src}>
  <BreadcrumbSchema
    items={[
      { name: 'Início', url: '/' },
      { name: 'Projetos', url: '/projetos' },
      { name: title, url: `/projetos/${entry.id}` },
    ]}
  />
  <article>
    <header class="shell pt-[calc(var(--header-y)+4rem)]">
      <div class="flex items-center justify-between gap-4">
        <a href="/projetos" class="caption link-rule tap text-concrete">Projetos</a>
        <p class="caption text-concrete">({indexLabel})</p>
      </div>

      <div class="mt-[clamp(2.5rem,6vw,5rem)] grid grid-cols-12 gap-5">
        <div class="col-span-12 lg:col-span-8">
          <h1
            class="text-[clamp(2.4rem,8.5vw,8.5rem)] leading-[0.88] tracking-[-0.05em] text-balance break-words"
          >
            {title}
          </h1>
          {subtitle && <p class="body-copy mt-6 max-w-[38ch] text-concrete">{subtitle}</p>}
        </div>
      </div>

      <dl
        class="rule-top mt-[clamp(3rem,6vw,5rem)] grid grid-cols-2 gap-x-6 gap-y-6 py-6 sm:grid-cols-3 lg:grid-cols-6"
      >
        <div>
          <dt class="caption text-concrete mb-2">Local</dt>
          <dd class="body-copy">{location}</dd>
        </div>
        <div>
          <dt class="caption text-concrete mb-2">Ano</dt>
          <dd class="body-copy tabular-nums">{year}</dd>
        </div>
        <div>
          <dt class="caption text-concrete mb-2">Tipologia</dt>
          <dd class="body-copy">{typology}</dd>
        </div>
        <div>
          <dt class="caption text-concrete mb-2">Escopo</dt>
          <dd class="body-copy">{scope.join(', ')}</dd>
        </div>
        {
          area && (
            <div>
              <dt class="caption text-concrete mb-2">Área</dt>
              <dd class="body-copy tabular-nums">{area}</dd>
            </div>
          )
        }
        {
          photography && (
            <div>
              <dt class="caption text-concrete mb-2">Fotografia</dt>
              <dd class="body-copy">{photography}</dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="mt-[clamp(1rem,3vw,2rem)]">
      {
        video ? (
          <video
            class="h-[80svh] w-full object-cover"
            src={video}
            poster={poster?.src}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          />
        ) : cover ? (
          <Image
            src={cover}
            alt={coverAlt ?? title}
            class="h-[80svh] w-full object-cover"
            widths={[800, 1200, 1600, 2000, 2560]}
            sizes="100vw"
            format="webp"
            loading="eager"
          />
        ) : (
          <div class="inverse plan-grid relative flex h-[70svh] items-end p-[var(--gutter)]">
            <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
              <span class="plan-index">{indexLabel}</span>
            </div>
            <div class="relative flex w-full items-end justify-between gap-6">
              <span class="caption text-paper/70">Fotografia em breve</span>
              <span class="caption text-paper/70">{typology} — {location}</span>
            </div>
          </div>
        )
      }
    </div>

    <section class="shell py-[clamp(4rem,8vw,8rem)]">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-2">
          <p class="caption text-concrete">Sobre o projeto</p>
        </div>
        <div class="md:col-span-6 md:col-start-4">
          <p class="body-copy text-[clamp(1.15rem,1.6vw,1.4rem)] leading-[1.35] tracking-[-0.02em]">
            {summary}
          </p>
          <div class="prose-mono mt-10 max-w-[62ch] text-concrete [&_strong]:text-ink">
            <Content />
          </div>
        </div>
      </div>
    </section>

    {
      gallery.length > 0 && (
        <section class="shell mt-[clamp(2rem,4vw,4rem)]">
          <AdaptiveGallery gallery={gallery} galleryAlt={galleryAlt} projectTitle={title} />
        </section>
      )
    }

    <section class="shell py-[clamp(4rem,8vw,8rem)]">
      <p class="caption text-concrete">Gostou deste projeto?</p>
      <p class="mt-5 max-w-[22ch] text-[clamp(2rem,4.6vw,4.2rem)] leading-[0.95] tracking-[-0.045em]">
        Vamos conversar sobre o seu.
      </p>
      <a
        href={SITE.whatsappHref}
        target="_blank"
        rel="noopener"
        class="caption mt-8 inline-flex items-center gap-2 border-b border-hairline pb-1 transition-opacity hover:opacity-50 tap"
      >
        Falar no WhatsApp <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="inverse relative isolate overflow-hidden">
      {
        next.data.cover && (
          <Image
            src={next.data.cover}
            alt={next.data.coverAlt ?? ''}
            class="absolute inset-0 -z-10 h-full w-full object-cover"
            widths={[800, 1200, 1600, 2000]}
            sizes="100vw"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        )
      }
      <div class="scrim absolute inset-0 -z-10" aria-hidden="true"></div>
      <a
        href={`/projetos/${next.id}`}
        class="shell group relative flex min-h-[60svh] flex-col justify-between py-[var(--header-y)]"
      >
        <div class="flex items-start justify-between gap-4">
          <span class="caption text-paper">Próximo projeto</span>
          <span class="caption text-paper">{next.data.year}</span>
        </div>
        <div class="flex items-end justify-between gap-6">
          <h2
            class="max-w-[16ch] text-[clamp(2rem,7vw,7rem)] leading-[0.88] tracking-[-0.05em] text-balance break-words transition-opacity group-hover:opacity-55"
          >
            {next.data.title}
          </h2>
          <span class="caption hidden shrink-0 pb-2 text-paper/80 sm:block">
            {next.data.typology} — {next.data.location}
          </span>
        </div>
      </a>
    </section>
  </article>
</BaseLayout>
