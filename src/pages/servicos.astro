---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { SERVICES, SITE } from '@/site.config';
import imgProjeto from '@/assets/projects/casa-brut/01-cover.webp';
import imgInteriores from '@/assets/projects/apartamento-rosarinho/01-cover.webp';
import imgObra from '@/assets/projects/bangalo-60-carneiros/01-cover.webp';

const process = [
  {
    index: '01',
    title: 'Escuta e lugar',
    body: 'Entendemos o programa, o orçamento e o terreno. Visitamos o imóvel e medimos o que existe antes de desenhar.',
  },
  {
    index: '02',
    title: 'Conceito',
    body: 'Estudos de implantação, volumetria e materialidade. Poucas alternativas, bem resolvidas, para decidir com clareza.',
  },
  {
    index: '03',
    title: 'Projeto executivo',
    body: 'Detalhamento completo, compatibilização e quantitativos. O documento que permite orçar e construir sem improviso.',
  },
  {
    index: '04',
    title: 'Obra e entrega',
    body: 'Acompanhamento técnico, compras e fiscalização. Entregamos a obra pronta, com o desenho que foi aprovado.',
  },
];
---

<BaseLayout
  title="Serviços"
  description="Projeto arquitetônico, interiores, execução de obra e consultoria no Recife — Trópikos Arquitetos."
>
  <section class="shell pt-[calc(var(--header-y)+5rem)]">
    <p class="caption text-concrete">(03) Serviços</p>
    <div class="mt-6 grid grid-cols-12 gap-5">
      <div class="col-span-12 lg:col-span-8">
        <h1
          class="max-w-[14ch] text-[clamp(2.4rem,8vw,8rem)] leading-[0.88] tracking-[-0.05em] text-balance break-words"
        >
          Do primeiro estudo à entrega.
        </h1>
      </div>
      <div class="col-span-12 lg:col-span-4 lg:pt-16">
        <p class="body-copy max-w-[32ch] text-concrete">
          Quatro frentes de trabalho que podem acontecer juntas ou separadas. Você escolhe até onde
          quer ir — nós dizemos o que cada etapa exige.
        </p>
      </div>
    </div>
  </section>

  <section class="shell mt-[clamp(4rem,8vw,7rem)]">
    <div class="rule-top py-4">
      <h2 class="caption">Frentes</h2>
    </div>
    <ul>
      {
        SERVICES.map((service) => (
          <li class="border-b border-hairline py-8 sm:py-10">
            <div class="grid grid-cols-[2.2rem_1fr] gap-x-4 sm:grid-cols-[3.5rem_1.1fr_1fr] sm:gap-6">
              <span class="index text-concrete">{service.index}</span>
              <div>
                <h3 class="text-[clamp(1.5rem,2.6vw,2.25rem)] leading-[1.06] tracking-[-0.035em]">
                  {service.title}
                </h3>
                <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1.5">
                  {service.items.map((item) => (
                    <li class="caption text-concrete">{item}</li>
                  ))}
                </ul>
              </div>
              <p class="body-copy col-span-2 mt-4 max-w-[40ch] text-concrete sm:col-span-1 sm:mt-0">
                {service.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell pb-[clamp(4rem,8vw,8rem)]">
    <div class="rule-top flex items-baseline justify-between gap-4 py-4 mb-6">
      <h2 class="caption">Matéria construída</h2>
      <a href="/projetos" class="caption link-rule text-concrete">Ver portfólio completo ↗</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <a href="/projetos/casa-brut" class="group block overflow-hidden">
        <div class="aspect-[16/11] sm:aspect-[4/3] w-full overflow-hidden bg-hairline">
          <Image
            src={imgProjeto}
            alt="Projeto Arquitetônico — Casa BRUT"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            widths={[500, 800]}
            sizes="(min-width: 768px) 33vw, 100vw"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="caption mt-3 flex items-center justify-between text-concrete">
          <span class="text-ink">01 Projeto Arquitetônico</span>
          <span>Casa BRUT</span>
        </p>
      </a>

      <a href="/projetos/apartamento-rosarinho" class="group block overflow-hidden">
        <div class="aspect-[16/11] sm:aspect-[4/3] w-full overflow-hidden bg-hairline">
          <Image
            src={imgInteriores}
            alt="Interiores e Marcenaria — Apartamento Rosarinho"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            widths={[500, 800]}
            sizes="(min-width: 768px) 33vw, 100vw"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="caption mt-3 flex items-center justify-between text-concrete">
          <span class="text-ink">02 Interiores e Marcenaria</span>
          <span>Apto Rosarinho</span>
        </p>
      </a>

      <a href="/projetos/bangalo-60-carneiros" class="group block overflow-hidden">
        <div class="aspect-[16/11] sm:aspect-[4/3] w-full overflow-hidden bg-hairline">
          <Image
            src={imgObra}
            alt="Execução e Acompanhamento — Bangalô 60 Carneiros"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            widths={[500, 800]}
            sizes="(min-width: 768px) 33vw, 100vw"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="caption mt-3 flex items-center justify-between text-concrete">
          <span class="text-ink">03 Execução de Obra</span>
          <span>Bangalô 60</span>
        </p>
      </a>
    </div>
  </section>

  <section class="inverse">
    <div class="shell py-[clamp(4rem,8vw,8rem)]">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-2">
          <p class="caption text-concrete">Processo</p>
        </div>
        <div class="md:col-span-8 md:col-start-4">
          <ol>
            {
              process.map((step) => (
                <li class="border-b border-paper/25 py-7 first:pt-0">
                  <div class="grid grid-cols-[2.2rem_1fr] gap-x-4 sm:grid-cols-[3.5rem_1fr_1.2fr] sm:gap-6">
                    <span class="index text-concrete">{step.index}</span>
                    <h3 class="text-[clamp(1.25rem,2vw,1.65rem)] leading-[1.12] tracking-[-0.025em]">
                      {step.title}
                    </h3>
                    <p class="body-copy col-span-2 mt-2 text-concrete sm:col-span-1 sm:mt-0">
                      {step.body}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="shell py-[clamp(4rem,8vw,8rem)]">
    <p class="caption text-concrete">Próximo passo</p>
    <p class="mt-5 max-w-[22ch] text-[clamp(2rem,4.6vw,4.2rem)] leading-[0.95] tracking-[-0.045em]">
      Conte o que você quer construir.
    </p>
    <a
      href={`https://wa.me/${SITE.whatsapp}`}
      target="_blank"
      rel="noopener"
      class="caption mt-8 inline-flex items-center gap-2 border-b border-hairline pb-1 transition-opacity hover:opacity-50"
    >
      Falar no WhatsApp <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>
