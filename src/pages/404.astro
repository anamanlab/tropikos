---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" robots="noindex, follow">
  <section class="shell flex min-h-[80svh] flex-col justify-center pb-20">
    <p class="caption text-concrete">404</p>
    <h1
      class="mt-5 max-w-[14ch] text-[clamp(2.8rem,8vw,8rem)] leading-[0.88] tracking-[-0.05em]"
    >
      Esta página não existe.
    </h1>
    <p class="body-copy mt-6 max-w-[36ch] text-concrete">
      O endereço pode ter mudado ou o projeto saiu do ar. Volte ao início ou veja o índice
      completo.
    </p>
    <div class="mt-8 flex flex-wrap gap-8">
      <a href="/" class="caption link-rule">Início</a>
      <a href="/projetos" class="caption link-rule">Projetos</a>
      <a href="/contato" class="caption link-rule">Contato</a>
    </div>
  </section>
</BaseLayout>
