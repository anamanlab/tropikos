---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro';
import { SITE } from '@/site.config';

const faqs = [
  {
    q: 'O que faz um arquiteto?',
    a: 'Um arquiteto projeta e acompanha a construção ou reforma de um espaço: estuda o terreno, define a implantação, a volumetria, os materiais, a iluminação e o detalhamento executivo. Também fiscaliza a obra para que o desenho aprovado seja executado como planejado.',
  },
  {
    q: 'Por que contratar um arquiteto e não só um engenheiro ou designer?',
    a: 'O arquiteto integra técnica, estética e modo de morar: resolve a implantação no terreno, a luz, a ventilação e a materialidade, e acompanha a obra até a entrega. Engenheiro e designer atuam em partes específicas; o arquiteto coordena o todo.',
  },
  {
    q: 'Quanto custa um projeto arquitetônico?',
    a: 'O honorário depende da área, da complexidade e do escopo (projeto, interiores, execução). Não trabalhamos com tabela fechada: na primeira conversa alinhamos escopo, etapas e valores de acordo com o seu projeto. Fale conosco pelo WhatsApp.',
  },
  {
    q: 'Como funciona o processo de um projeto?',
    a: 'Em quatro etapas: escuta e lugar (programa, orçamento, visita ao imóvel), conceito (implantação, volumetria, materialidade), projeto executivo (detalhamento completo e quantitativos) e obra e entrega (acompanhamento técnico até a entrega das chaves).',
  },
  {
    q: 'Quanto tempo leva um projeto de arquitetura?',
    a: 'Um estudo preliminar leva de 3 a 6 semanas. O projeto executivo, de 8 a 16 semanas, dependendo da complexidade. A obra varia conforme o tamanho e o ritmo de execução. Definimos cronograma realista na proposta.',
  },
  {
    q: 'Vocês acompanham a obra?',
    a: 'Sim. A execução e a obra fazem parte do nosso trabalho: orçamento, cronograma, compras e fiscalização técnica. Projeto e execução sob o mesmo teto reduzem ruído e mantêm a intenção original até a entrega.',
  },
  {
    q: 'Trabalham com reformas de apartamento?',
    a: 'Sim. Reformas residenciais são uma das nossas frentes: projeto, interiores e execução. Para começar, envie o endereço do imóvel, algumas fotos e uma ideia de prazo; alinhamos escopo e etapas na primeira conversa.',
  },
  {
    q: 'Atendem quais cidades e regiões?',
    a: 'O estúdio tem sede no Recife, no Parnamirim, e atende a capital e mais cinco cidades de Pernambuco: Olinda, Jaboatão dos Guararapes, Paulista, Caruaru e Gravatá. Levantamento, vistorias de obra e entrega são visitas agendadas, com o deslocamento previsto no escopo antes da contratação.',
  },
  {
    q: 'É obrigatório ter arquiteto para construir ou reformar?',
    a: 'Para obras que alteram estrutura, fachada ou uso, a lei exige um profissional habilitado (arquiteto ou engenheiro) com registro no CAU/CREA. Mesmo em casos não obrigatórios, um projeto evita erros, retrabalho e custos extras.',
  },
  {
    q: 'O que é um projeto executivo?',
    a: 'É o detalhamento completo do projeto: plantas, cortes, elevações, detalhes construtivos e quantitativos. É o documento que permite orçar e construir sem improviso, evitando surpresas na obra.',
  },
  {
    q: 'Como escolher um arquiteto para o meu projeto?',
    a: 'Avalie o portfólio (projetos semelhantes ao seu), o método de trabalho, a presença na obra e o alinhamento de valores. Peça referências de clientes, entenda o escopo e o cronograma propostos, e verifique o registro no CAU.',
  },
  {
    q: 'Vocês fazem projetos de interiores também?',
    a: 'Sim. Interiores é uma das nossas frentes: materiais, marcenaria, iluminação e mobiliário desenhados em conjunto com a arquitetura, sem ruído entre projeto e obra.',
  },
  {
    q: 'Como solicitar um orçamento?',
    a: 'Envie o endereço do imóvel, algumas fotos e uma ideia de prazo para o nosso WhatsApp ou e-mail. Na primeira conversa alinhamos escopo, etapas e honorários.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout title="Perguntas frequentes" description="Perguntas frequentes sobre arquitetura, projetos, reformas e contratação de arquiteto no Recife — Trópikos Arquitetos.">
  <BreadcrumbSchema items={[{ name: 'Início', url: '/' }, { name: 'Perguntas frequentes', url: '/perguntas' }]} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <section class="shell pt-[calc(var(--header-y)+5rem)]">
    <p class="caption text-concrete">(FAQ) Perguntas frequentes</p>
    <h1
      class="mt-6 max-w-[16ch] text-[clamp(2.4rem,7.4vw,7.4rem)] leading-[0.9] tracking-[-0.05em] text-balance break-words"
    >
      Dúvidas comuns
    </h1>
    <p class="body-copy mt-6 max-w-[52ch] text-concrete">
      Respostas diretas sobre arquitetura, projetos, reformas e como trabalhamos no Recife.
    </p>
  </section>

  <section class="shell py-[clamp(4rem,8vw,8rem)]">
    <div class="max-w-[72ch]">
      {
        faqs.map((f) => (
          <details class="border-b border-hairline py-6 group">
            <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4">
              <span class="text-[clamp(1.15rem,1.8vw,1.5rem)] leading-[1.15] tracking-[-0.02em]">
                {f.q}
              </span>
              <span class="caption text-concrete transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="body-copy mt-4 text-concrete">{f.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-[clamp(3rem,6vw,5rem)]">
      <p class="caption text-concrete">Fora do Recife</p>
      <p class="body-copy mt-3 max-w-[52ch] text-concrete">
        Olinda, Jaboatão dos Guararapes, Paulista, Caruaru e Gravatá têm cada uma sua própria
        página, com o que muda no projeto e como funcionam as visitas.
      </p>
      <a
        href="/atuacao"
        class="caption link-rule mt-4 inline-flex text-concrete tap">Ver as cidades atendidas ↗</a
      >
    </div>

    <div class="mt-[clamp(3rem,6vw,5rem)]">
      <p class="caption text-concrete">Não encontrou sua dúvida?</p>
      <a
        href={SITE.whatsappHref}
        target="_blank"
        rel="noopener"
        class="caption mt-4 inline-flex items-center gap-2 border-b border-hairline pb-1 transition-opacity hover:opacity-50 tap"
      >
        Falar no WhatsApp <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>