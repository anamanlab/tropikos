---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectBand from '@/components/ProjectBand.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import { SERVICES, SITE } from '@/site.config';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((entry) => entry.data.featured).slice(0, 4);
---

<BaseLayout title={`${SITE.name} — Arquitetura no Recife`}>
  <section class="flex min-h-[100svh] flex-col">
    <div
      class="shell grid grid-cols-12 gap-5 pt-[calc(var(--header-y)+4rem)] sm:pt-[calc(var(--header-y)+5.5rem)]"
    >
      <div class="col-span-12 md:col-span-5 md:col-start-7">
        <p class="body-copy max-w-[25rem]">
          <span class="text-ink">Trópikos Arquitetos</span>{' '}
          <span class="text-concrete">
            é um escritório de arquitetura e interiores no Recife. Projetamos e executamos obras
            com atenção ao lugar, ao clima e ao modo de morar de cada cliente.
          </span>
        </p>
        <p class="caption mt-6 text-concrete">Desde {SITE.founded} — Parnamirim, Recife</p>
      </div>
    </div>

    <div
      class="hero-film relative isolate mt-auto flex min-h-[clamp(26rem,66svh,52rem)] flex-col justify-between overflow-hidden bg-onyx py-[var(--header-y)] text-paper"
    >
      <picture class="absolute inset-0 -z-10 block h-full w-full">
        <source media="(max-width: 767px)" srcset="/media/hero-tropikos-tall-poster.webp" type="image/webp" />
        <img
          src="/media/hero-tropikos-wide-poster.webp"
          alt=""
          width="1280"
          height="720"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </picture>
      <video
        data-hero-video
        src="/media/hero-tropikos-wide.mp4"
        poster="/media/hero-tropikos-wide-poster.webp"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        width="1280"
        height="720"
        aria-label="Registro de interiores: sala de estar do Apartamento Edf Diva com cobogó terracota, iluminação quente, sofá curvo e marcenaria autoral"
      >
        <source media="(max-width: 767px)" src="/media/hero-tropikos-tall.mp4" type="video/mp4" />
        <source src="/media/hero-tropikos-wide.mp4" type="video/mp4" />
      </video>
      <div class="hero-film-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

      <div class="shell flex items-start justify-between gap-4">
        <p class="caption text-paper/90">Registro de interiores · Apartamento Edf Diva</p>
      </div>

      <div>
        <div class="crop">
          <h1 class="wordmark text-paper" aria-label="Trópikos">TRÓPIKOS</h1>
        </div>
        <div class="shell rule-top-soft mt-5 flex flex-wrap items-baseline justify-between gap-3 pt-4">
          <p class="caption text-paper/80">Arquitetura autoral · Obra sob controle</p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <a href="/projetos/apartamento-edf-diva" class="caption link-rule text-paper/80">
              Ver o projeto ↗
            </a>
            <p class="caption hidden text-paper/80 sm:block">Recife — PE · 08°03′S 34°52′W</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="shell pt-[clamp(5rem,10vw,10rem)]">
    <div class="rule-top flex items-baseline justify-between gap-4 py-4">
      <h2 class="caption">Projetos selecionados</h2>
      <p class="caption text-concrete">({String(featured.length).padStart(2, '0')})</p>
    </div>
  </section>

  <div class="mt-4 sm:mt-8 space-y-3 sm:space-y-6 bg-paper">
    {
      featured.map((entry, i) => (
        <ProjectBand
          index={`(${String(i + 1).padStart(2, '0')})`}
          title={entry.data.title}
          href={`/projetos/${entry.id}`}
          location={entry.data.location}
          year={entry.data.year}
          typology={entry.data.typology}
          image={entry.data.cover}
          imageAlt={entry.data.coverAlt}
          video={entry.data.video}
          poster={entry.data.poster}
        />
      ))
    }
  </div>

  <section class="shell pt-[clamp(4rem,8vw,8rem)] pb-[clamp(4rem,8vw,8rem)]">
    <div class="rule-top flex items-baseline justify-between gap-4 py-4">
      <h2 class="caption">Índice de projetos</h2>
      <a href="/projetos" class="caption link-rule text-concrete">Ver todos ↗</a>
    </div>
    <div>
      {projects.map((entry, i) => <ProjectRow entry={entry} index={i + 1} />)}
    </div>
  </section>

  <section class="inverse">
    <div class="shell grid grid-cols-1 items-center gap-12 py-[clamp(4rem,8vw,7rem)] md:grid-cols-12 md:gap-10">
      <figure class="md:col-span-5 md:col-start-2">
        <a href="/estudio" class="group block" aria-label="Conhecer o estúdio">
          <div class="relative mx-auto aspect-[4/5] w-full max-w-[21rem] overflow-hidden bg-black">
            <img
              src="/media/estudio-processo.webp"
              alt="Mesa de trabalho em um estúdio de arquitetura, com desenhos emoldurados na parede, planta alta e cortina iluminada"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              width="1000"
              height="1250"
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>
        <figcaption class="caption mt-3 flex items-center justify-between gap-4 text-concrete">
          <span>Espaço de trabalho</span>
          <span>Luz e matéria</span>
        </figcaption>
      </figure>

      <div class="md:col-span-4 md:col-start-8">
        <p class="caption text-concrete">O estúdio</p>
        <p class="mt-6 text-[clamp(1.8rem,3.2vw,3rem)] leading-[1.04] tracking-[-0.04em] text-balance">
          O projeto não termina no papel.
        </p>
        <p class="body-copy mt-5 max-w-[36ch] text-concrete">
          Acompanhamos cada obra de perto — do primeiro estudo à entrega das chaves — para que a
          arquitetura chegue de pé ao fim.
        </p>
        <a
          href="/estudio"
          class="caption mt-9 inline-flex items-center gap-2 border-b border-paper/60 pb-1 transition-colors hover:border-paper"
        >
          Conhecer o estúdio <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="shell py-[clamp(4rem,8vw,8rem)]">
    <div class="rule-top flex items-baseline justify-between gap-4 py-4">
      <h2 class="caption">Serviços</h2>
      <a href="/servicos" class="caption link-rule text-concrete">Ver detalhes ↗</a>
    </div>
    <ul>
      {
        SERVICES.map((service) => (
          <li class="border-b border-hairline py-6 sm:py-8">
            <a
              href="/servicos"
              class="grid grid-cols-[2.2rem_1fr] items-baseline gap-x-4 sm:grid-cols-[3.5rem_1fr_1fr] sm:gap-6"
            >
              <span class="index text-concrete">{service.index}</span>
              <span class="text-[clamp(1.3rem,2.3vw,1.9rem)] leading-[1.1] tracking-[-0.03em]">
                {service.title}
              </span>
              <span class="body-copy col-span-2 mt-2 max-w-[36ch] text-concrete sm:col-span-1 sm:mt-0">
                {service.body}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <script>
    const hero = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hero) {
      hero.muted = true;
      hero.defaultMuted = true;

      if (reduceMotion) {
        hero.pause();
      } else {
        const tryPlay = () => {
          hero.muted = true;
          hero.defaultMuted = true;
          hero.play().catch(() => {
            // Autoplay blocked: wait for a user gesture (handled below).
          });
        };

        // Native autoplay with an explicit `src` should start on its own;
        // this is only a safety net for late-loading media.
        if (hero.readyState >= 2) {
          tryPlay();
        } else {
          hero.addEventListener('loadeddata', tryPlay, { once: true });
        }

        // Unlock on first user interaction if autoplay was blocked.
        const unlock = () => {
          if (hero.paused && !reduceMotion) tryPlay();
        };
        window.addEventListener('click', unlock, { passive: true, once: true });
        window.addEventListener('touchstart', unlock, { passive: true, once: true });
        window.addEventListener('scroll', unlock, { passive: true, once: true });
      }
    }
  </script>
</BaseLayout>
