---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro';
import { SITE } from '@/site.config';

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${SITE.address.street}, ${SITE.address.building}, ${SITE.address.district}, ${SITE.address.city} - ${SITE.address.state}, ${SITE.address.postalCode}`,
)}`;
---

<BaseLayout
  title="Contato"
  description="Fale com o Trópikos Arquitetos por e-mail, WhatsApp ou visite o escritório em Parnamirim, Recife. Atendimento de segunda a sexta, 9h–18h."
>
  <BreadcrumbSchema
    items={[
      { name: 'Início', url: '/' },
      { name: 'Contato', url: '/contact' },
    ]}
  />

  <section class="shell pt-[calc(var(--header-y)+5rem)] pb-[clamp(4rem,8vw,8rem)]">
    <p class="caption text-concrete">(Contact) Contato</p>
    <h1
      class="mt-6 max-w-[14ch] text-[clamp(2.4rem,7.4vw,7.4rem)] leading-[0.9] tracking-[-0.05em] text-balance break-words"
    >
      Fale com o estúdio.
    </h1>
    <p class="body-copy mt-6 max-w-[54ch] text-concrete">
      Conte o que você quer transformar. Atendemos por e-mail e WhatsApp, e recebemos visitas no
      escritório em Parnamirim, Recife, com hora marcada. Respondemos em até um dia útil.
    </p>

    <div class="mt-[clamp(3rem,7vw,6rem)] grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-6">
        <div class="rule-top pt-5">
          <h2 class="caption text-concrete">Canais diretos</h2>
          <dl class="body-copy mt-4 grid gap-6">
            <div>
              <dt class="caption text-concrete">E-mail</dt>
              <dd class="mt-1">
                <a href={`mailto:${SITE.email}`} class="link-rule tap break-all">{SITE.email}</a>
              </dd>
            </div>
            <div>
              <dt class="caption text-concrete">WhatsApp</dt>
              <dd class="mt-1">
                <a
                  href={SITE.whatsappHref}
                  target="_blank"
                  rel="noopener"
                  class="link-rule tap"
                >
                  {SITE.phone}
                </a>
              </dd>
            </div>
            <div>
              <dt class="caption text-concrete">Telefone alternativo</dt>
              <dd class="mt-1">
                <a href={`tel:${SITE.phoneAlt.replace(/\s/g, '')}`} class="link-rule tap">
                  {SITE.phoneAlt}
                </a>
              </dd>
            </div>
            <div>
              <dt class="caption text-concrete">Instagram</dt>
              <dd class="mt-1">
                <a
                  href={SITE.instagram}
                  target="_blank"
                  rel="noopener"
                  class="link-rule tap"
                >
                  {SITE.instagramHandle}
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="md:col-span-5 md:col-start-8">
        <div class="rule-top pt-5">
          <h2 class="caption text-concrete">Escritório</h2>
          <address class="body-copy mt-4 not-italic">
            {SITE.address.street}<br />
            {SITE.address.building}<br />
            {SITE.address.district}<br />
            {SITE.address.city} — {SITE.address.state}<br />
            {SITE.address.postalCode}
          </address>
          <p class="body-copy mt-4 text-concrete">
            Segunda a sexta, 9h–18h. Visitas com hora marcada.
          </p>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener"
            class="caption mt-5 inline-flex items-center gap-2 border-b border-hairline pb-1 transition-opacity hover:opacity-50 tap"
          >
            Abrir no Google Maps <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-[clamp(3rem,7vw,6rem)] max-w-[62ch]">
      <div class="rule-top pt-5">
        <h2 class="caption text-concrete">Como começar um projeto</h2>
        <p class="body-copy mt-4 text-concrete">
          Envie o endereço do imóvel, algumas fotos, uma descrição do que precisa mudar e uma ideia
          de prazo. Na primeira conversa alinhamos escopo, etapas e honorários. Se você ainda não
          tem um imóvel, podemos conversar sobre busca, viabilidade e potencial do terreno.
        </p>
        <p class="body-copy mt-4 text-concrete">
          Para dúvidas sobre prazos, escopo ou contratação de arquiteto, consulte as
          <a href="/perguntas" class="link-rule tap">perguntas frequentes</a>. Para saber como
          tratamos seus dados, leia a
          <a href="/privacy" class="link-rule tap">política de privacidade</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
