---
// LGPD consent banner. Persists the choice in a first-party cookie (shared by
// tropikos.com.br and www.tropikos.com.br) and localStorage; updates GA4
// Consent Mode v2.
---
<div
  id="consent-banner"
  class="fixed bottom-3 left-3 right-3 z-[60] hidden max-w-sm rounded-md border border-hairline bg-paper/95 p-3 text-ink shadow-sm backdrop-blur sm:left-auto sm:right-4"
  role="dialog"
  aria-live="polite"
  aria-label="Consentimento de cookies"
>
  <p class="caption text-concrete">
    Usamos cookies para medir acessos. Aceitar ou recusar?
  </p>
  <div class="mt-2 flex items-center gap-4">
    <button
      type="button"
      data-consent="deny"
      class="caption border-b border-hairline pb-0.5 transition-opacity hover:opacity-50 tap"
    >
      Recusar
    </button>
    <button
      type="button"
      data-consent="accept"
      class="caption border-b border-hairline pb-0.5 transition-opacity hover:opacity-50 tap"
    >
      Aceitar
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'tropikos_consent';
    var MAX_AGE = 60 * 60 * 24 * 365; // 1 year
    var banner = document.getElementById('consent-banner');
    if (!banner) return;

    function apply(choice) {
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: choice === 'accept' ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
      }
    }

    // Share the choice between the apex and www hosts. Other hosts (local dev,
    // workers.dev previews) get a host-only cookie.
    function cookieDomain() {
      return /(^|\.)tropikos\.com\.br$/.test(window.location.hostname)
        ? '; Domain=tropikos.com.br'
        : '';
    }

    function readCookie() {
      var prefix = KEY + '=';
      var parts = document.cookie ? document.cookie.split('; ') : [];
      for (var i = 0; i < parts.length; i++) {
        if (parts[i].indexOf(prefix) === 0) {
          try { return decodeURIComponent(parts[i].slice(prefix.length)); } catch (e) { return null; }
        }
      }
      return null;
    }

    function writeCookie(choice) {
      document.cookie = KEY + '=' + encodeURIComponent(choice) +
        '; Path=/; Max-Age=' + MAX_AGE + '; SameSite=Lax' +
        (window.location.protocol === 'https:' ? '; Secure' : '') +
        cookieDomain();
    }

    function readStored() {
      // The cookie wins because it is the value shared across apex and www.
      // localStorage is the fallback for visitors who accepted before the
      // cookie was introduced, or where cookies are unavailable.
      var fromCookie = readCookie();
      if (fromCookie === 'accept' || fromCookie === 'deny') return fromCookie;

      var value = null;
      try { value = localStorage.getItem(KEY); } catch (e) {}
      return value === 'accept' || value === 'deny' ? value : null;
    }

    function store(choice) {
      try { localStorage.setItem(KEY, choice); } catch (e) {}
      writeCookie(choice);
    }

    var stored = readStored();

    if (stored) {
      // Keep both stores in sync in case a previous visit only wrote one.
      store(stored);
      apply(stored);
      return;
    }

    // No choice yet — show banner and hide the floating WhatsApp button so it
    // doesn't overlap the consent actions.
    var floatBtn = document.querySelector('.whatsapp-float');
    if (floatBtn) floatBtn.classList.add('hidden');
    banner.classList.remove('hidden');

    banner.querySelectorAll('[data-consent]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var choice = btn.getAttribute('data-consent');
        if (choice !== 'accept' && choice !== 'deny') return;
        store(choice);
        apply(choice);
        banner.classList.add('hidden');
        var floatBtn2 = document.querySelector('.whatsapp-float');
        if (floatBtn2) floatBtn2.classList.remove('hidden');
      });
    });
  })();
</script>