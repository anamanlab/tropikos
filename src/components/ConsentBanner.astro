---
// LGPD consent banner. The choice itself lives in window.tropikosConsent,
// installed by BaseHead before gtag('config') runs; this component is only the
// UI for granting, refusing, and revisiting it.
---
<div
  id="consent-banner"
  class="fixed bottom-3 left-3 right-3 z-[60] hidden max-w-sm rounded-md border border-hairline bg-paper/95 p-3 text-ink shadow-sm backdrop-blur sm:left-auto sm:right-4"
  role="dialog"
  aria-labelledby="consent-banner-title"
>
  <p id="consent-banner-title" class="caption text-concrete">
    Usamos cookies para medir acessos. Aceitar ou recusar?
  </p>
  <p data-consent-status class="caption text-concrete mt-2 hidden" role="status"></p>
  <div class="mt-2 flex flex-wrap items-center gap-4">
    <button
      type="button"
      data-consent="deny"
      class="caption border-b border-hairline pb-0.5 transition-opacity hover:opacity-50 tap"
    >
      Recusar
    </button>
    <button
      type="button"
      data-consent="accept"
      class="caption border-b border-hairline pb-0.5 transition-opacity hover:opacity-50 tap"
    >
      Aceitar
    </button>
    <button
      type="button"
      data-consent="close"
      class="caption link-rule text-concrete hidden tap"
    >
      Fechar
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById('consent-banner');
    var consent = window.tropikosConsent;
    if (!banner || !consent) return;

    var title = document.getElementById('consent-banner-title');
    var status = banner.querySelector('[data-consent-status]');
    var closeBtn = banner.querySelector('[data-consent="close"]');
    var acceptBtn = banner.querySelector('[data-consent="accept"]');
    var floatBtn = document.querySelector('.whatsapp-float');
    var trigger = null;
    var mode = 'closed';

    function label(choice) {
      return choice === 'accept' ? 'Analytics aceito' : 'Analytics recusado';
    }

    function show(nextMode) {
      mode = nextMode;
      banner.classList.remove('hidden');
      if (mode === 'revisit') {
        title.textContent = 'Preferências de cookie';
        status.textContent = 'Preferência atual: ' + label(consent.get());
        status.classList.remove('hidden');
        closeBtn.classList.remove('hidden');
        acceptBtn.focus();
      } else {
        title.textContent = 'Usamos cookies para medir acessos. Aceitar ou recusar?';
        status.classList.add('hidden');
        closeBtn.classList.add('hidden');
        if (floatBtn) floatBtn.classList.add('hidden');
      }
    }

    function hide() {
      mode = 'closed';
      banner.classList.add('hidden');
      if (floatBtn) floatBtn.classList.remove('hidden');
      if (trigger && document.contains(trigger)) trigger.focus();
    }

    function announce(message) {
      var live = document.createElement('p');
      live.className = 'caption sr-only';
      live.setAttribute('role', 'status');
      live.textContent = message;
      document.body.appendChild(live);
      window.setTimeout(function () { live.remove(); }, 5000);
    }

    banner.querySelectorAll('[data-consent]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var choice = btn.getAttribute('data-consent');
        if (choice === 'close') {
          hide();
          return;
        }
        if (choice !== 'accept' && choice !== 'deny') return;

        var wasRevisit = mode === 'revisit';
        consent.set(choice);
        consent.apply(choice);
        hide();
        if (wasRevisit) announce('Preferências de cookie salvas: ' + label(choice) + '.');
      });
    });

    document.addEventListener('click', function (event) {
      var opener = event.target.closest ? event.target.closest('[data-consent-open]') : null;
      if (!opener) return;
      event.preventDefault();
      trigger = opener;
      show('revisit');
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && mode !== 'closed') hide();
    });

    // A stored choice means BaseHead already set the right consent default, so
    // there is nothing to ask on load. The banner still opens on demand above.
    if (!consent.get()) show('first-visit');
  })();
</script>
