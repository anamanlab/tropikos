---
import Logo from '@/components/Logo.astro';
import { NAV_LINKS, SITE, telHref } from '@/site.config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<div
  id="menu-overlay"
  class="menu-overlay fixed inset-0 z-50 flex flex-col overflow-y-auto bg-paper text-ink"
  role="dialog"
  aria-modal="true"
  aria-label="Menu principal"
  hidden
>
  <div
    class="shell grid grid-cols-[1fr_auto_1fr] items-center gap-3 pt-[var(--header-y)] sm:gap-6"
  >
    <p class="caption col-start-1 hidden items-baseline gap-1.5 tabular-nums sm:flex">
      <span data-clock="rec" data-timezone={SITE.timezone}>--:--:--</span>
      <span class="text-concrete">{SITE.cityCode}</span>
    </p>
    <a
      href="/"
      aria-label="Trópikos Arquitetos — página inicial"
      class="col-start-2 justify-self-center transition-opacity hover:opacity-70"
    >
      <Logo
        variant="horizontal"
        color="color"
        class="h-auto w-[180px] sm:w-[220px]"
        decorative
      />
    </a>
    <button
      type="button"
      data-menu-close
      class="body-copy tap col-start-3 cursor-pointer justify-self-end px-1 -mx-1"
    >
      Fechar
    </button>
  </div>

  <nav class="shell mt-[clamp(3rem,9vh,7rem)]" aria-label="Principal">
    <ul>
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="menu-link group"
              data-menu-link
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              <span class="caption text-concrete w-8 shrink-0 pb-[0.35em]">{link.index}</span>
              <span class="menu-link-label">{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mt-auto shell flex flex-col gap-8 pb-[var(--gutter)] pt-16">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div>
        <p class="caption text-concrete mb-2">Escritório</p>
        <p class="body-copy">
          {SITE.address.street}<br />
          {SITE.address.building}<br />
          {SITE.address.district} — {SITE.address.city}, {SITE.address.state}<br />
          {SITE.address.postalCode}
        </p>
      </div>
      <div>
        <p class="caption text-concrete mb-2">Contato</p>
        <p class="body-copy">
          <a class="link-rule tap" href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          <a class="link-rule tap" href={telHref(SITE.phone)}>{SITE.phone}</a><br />
          <a class="link-rule tap" href={SITE.whatsappHref} target="_blank" rel="noopener">
            WhatsApp ↗
          </a>
        </p>
      </div>
      <div>
        <p class="caption text-concrete mb-2">Social</p>
        <p class="body-copy">
          <a class="link-rule tap" href={SITE.instagram} target="_blank" rel="noopener">
            {SITE.instagramHandle} ↗
          </a><br />
          <a class="link-rule tap" href={SITE.linktree} target="_blank" rel="noopener">
            Linktree ↗
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .menu-overlay {
    opacity: 0;
    visibility: hidden;
    transition: opacity 320ms ease, visibility 320ms ease;
  }
  .menu-overlay[data-open] {
    opacity: 1;
    visibility: visible;
  }
  .menu-overlay[data-open] .menu-link {
    animation: rise 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .menu-overlay[data-open] li:nth-child(2) .menu-link {
    animation-delay: 40ms;
  }
  .menu-overlay[data-open] li:nth-child(3) .menu-link {
    animation-delay: 80ms;
  }
  .menu-overlay[data-open] li:nth-child(4) .menu-link {
    animation-delay: 120ms;
  }
  .menu-overlay[data-open] li:nth-child(5) .menu-link {
    animation-delay: 160ms;
  }
  .menu-link[aria-current='page'] .menu-link-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  .menu-link[aria-current='page'] .caption {
    color: var(--color-ink);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>('#menu-overlay');
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const firstLink = overlay?.querySelector<HTMLAnchorElement>('[data-menu-link]');
  const pageRegions = ['header', 'main', 'footer']
    .map((selector) => document.querySelector<HTMLElement>(selector))
    .filter((el): el is HTMLElement => Boolean(el));

  function setPageInert(value: boolean) {
    pageRegions.forEach((region) => {
      if (value) region.setAttribute('inert', '');
      else region.removeAttribute('inert');
    });
  }

  function openMenu() {
    if (!overlay || !trigger) return;
    overlay.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    document.body.dataset.menuOpen = '';
    setPageInert(true);
    // Make the dialog visible before moving focus into it. Focusing while the
    // overlay is still `visibility: hidden` leaves focus on the document body.
    requestAnimationFrame(() => {
      overlay.setAttribute('data-open', '');
      requestAnimationFrame(() => firstLink?.focus({ preventScroll: true }));
    });
  }

  function closeMenu() {
    if (!overlay || !trigger) return;
    overlay.removeAttribute('data-open');
    trigger.setAttribute('aria-expanded', 'false');
    delete document.body.dataset.menuOpen;
    setPageInert(false);
    window.setTimeout(() => {
      overlay.hidden = true;
      trigger.focus({ preventScroll: true });
    }, 320);
  }

  trigger?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => {
      delete document.body.dataset.menuOpen;
      setPageInert(false);
    });
  });

  overlay?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const focusables = Array.from(
      overlay.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
    ).filter((el) => el.offsetParent !== null);
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && overlay && !overlay.hidden) closeMenu();
  });
</script>
