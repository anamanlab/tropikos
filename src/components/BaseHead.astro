---
import { Font } from 'astro:assets';
import { SITE } from '@/site.config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
}

const {
  title: pageTitle,
  description = SITE.description,
  image = '/og-image.jpg',
  type = 'website',
  robots = 'index, follow',
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-7KB6VK4D5Y';

const fullTitle = pageTitle.includes(SITE.name) ? pageTitle : `${pageTitle} — ${SITE.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const imageType = socialImage.pathname.endsWith('.png')
  ? 'image/png'
  : socialImage.pathname.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
const siteUrl = (Astro.site?.toString() ?? 'https://tropikos.com.br/').replace(/\/$/, '');
const organizationId = `${siteUrl}/#organization`;

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: `${SITE.address.street} — ${SITE.address.building}`,
  addressLocality: SITE.address.city,
  addressRegion: SITE.address.state,
  postalCode: SITE.address.postalCode,
  addressCountry: SITE.address.country,
};

const contactPoint = {
  '@type': 'ContactPoint',
  contactType: 'customer service',
  telephone: SITE.phone,
  email: SITE.email,
  areaServed: 'BR',
  availableLanguage: ['Portuguese'],
};

// A plain Organization node is the identity signal agents look for before
// they cite or recommend a business. The ArchitecturalService node below
// keeps the local-business details (geo, opening hours, price range).
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: SITE.name,
  alternateName: SITE.shortName,
  url: `${siteUrl}/`,
  logo: new URL('/icon-512.png', Astro.site).toString(),
  image: new URL('/og-image.jpg', Astro.site).toString(),
  description: SITE.description,
  foundingDate: String(SITE.founded),
  email: SITE.email,
  telephone: SITE.phone,
  address: postalAddress,
  contactPoint,
  sameAs: [SITE.instagram, SITE.linktree],
  knowsAbout: ['Arquitetura', 'Interiores', 'Execução de obra', 'Consultoria'],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ArchitecturalService',
  '@id': `${siteUrl}/#architectural-service`,
  parentOrganization: { '@id': organizationId },
  name: SITE.name,
  description: SITE.description,
  url: Astro.site?.toString(),
  email: SITE.email,
  telephone: SITE.phone,
  foundingDate: String(SITE.founded),
  priceRange: '$$',
  address: postalAddress,
  contactPoint,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -8.0476,
    longitude: -34.877,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
  areaServed: ['Recife', 'Pernambuco', 'Nordeste'],
  sameAs: [SITE.instagram, SITE.linktree],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE.name} />
<meta name="application-name" content={SITE.shortName} />
<meta name="apple-mobile-web-app-title" content={SITE.shortName} />

<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:type" content={imageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content="pt_BR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={fullTitle} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="mask-icon" href="/favicon.svg" color="#191919" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#191919" />
<meta name="robots" content={robots} />

<!-- Google Analytics 4 (gtag.js) + Consent Mode v2 (LGPD).
     Measurement ID: G-7KB6VK4D5Y. The base tag must load before consent so the
     defaults below can be declared and restored later, but analytics_storage
     stays denied until an explicit accept, so no cookie is set without consent. -->
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
<script is:inline define:vars={{ gaId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  var KEY = 'tropikos_consent';

  // Domain-level cookie shares the choice between tropikos.com.br and www.
  // Other hosts (local dev, workers.dev previews) get a host-only cookie.
  function cookieDomain() {
    return /(^|\.)tropikos\.com\.br$/.test(window.location.hostname)
      ? '; Domain=tropikos.com.br'
      : '';
  }

  function readCookie() {
    var prefix = KEY + '=';
    var parts = document.cookie ? document.cookie.split('; ') : [];
    for (var i = 0; i < parts.length; i++) {
      if (parts[i].indexOf(prefix) === 0) {
        try { return decodeURIComponent(parts[i].slice(prefix.length)); } catch (e) { return null; }
      }
    }
    return null;
  }

  function writeCookie(choice) {
    document.cookie = KEY + '=' + encodeURIComponent(choice) +
      '; Path=/; Max-Age=' + (60 * 60 * 24 * 365) + '; SameSite=Lax' +
      (window.location.protocol === 'https:' ? '; Secure' : '') +
      cookieDomain();
  }

  // The cookie wins because it is the value shared across apex and www.
  // localStorage is the fallback for visitors who accepted before the cookie
  // existed, or where cookies are unavailable.
  function readStored() {
    var fromCookie = readCookie();
    if (fromCookie === 'accept' || fromCookie === 'deny') return fromCookie;
    var value = null;
    try { value = localStorage.getItem(KEY); } catch (e) {}
    return value === 'accept' || value === 'deny' ? value : null;
  }

  function apply(choice) {
    gtag('consent', 'update', {
      analytics_storage: choice === 'accept' ? 'granted' : 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
  }

  // Read the stored choice before gtag('config') runs, otherwise a returning
  // visitor who already accepted would be initialised as denied and only flip
  // to granted later from the banner script.
  var stored = readStored();
  var defaults = {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: stored === 'accept' ? 'granted' : 'denied'
  };
  if (!stored) defaults.wait_for_update = 500;
  gtag('consent', 'default', defaults);

  window.tropikosConsent = {
    get: readStored,
    set: function (choice) {
      try { localStorage.setItem(KEY, choice); } catch (e) {}
      writeCookie(choice);
    },
    apply: apply
  };

  gtag('js', new Date());
  gtag('config', gaId, { send_page_view: true });
</script>

<Font cssVariable="--ff-body" preload />
<Font cssVariable="--ff-mono" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
