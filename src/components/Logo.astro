---
interface Props {
  variant?: 'horizontal' | 'stacked' | 'symbol';
  color?: 'color' | 'black' | 'white' | 'palm';
  class?: string;
  id?: string;
  decorative?: boolean;
}

const {
  variant = 'horizontal',
  color = 'color',
  class: className = '',
  id,
  decorative = false,
} = Astro.props;

// Determine colors
const isWhite = color === 'white';
const isBlack = color === 'black';
const isPalm = color === 'palm';

const inkColor = isWhite ? '#FFFFFF' : isBlack ? '#000000' : isPalm ? '#3D6E60' : '#191919';
const palmColor = isWhite ? '#FFFFFF' : isBlack ? '#000000' : isPalm ? '#3D6E60' : '#3D6E60';
const terraColor = isWhite ? '#FFFFFF' : isBlack ? '#000000' : isPalm ? '#3D6E60' : '#BA5424';
const ruleColor = isWhite ? '#FFFFFF' : isBlack ? '#000000' : '#191919';
