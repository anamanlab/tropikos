---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, typology, location, year } = entry.data;
---

<a
  href={`/projetos/${entry.id}`}
  data-category={entry.data.category}
  class="project-item project-row group grid grid-cols-[2.2rem_1fr_auto] items-baseline gap-x-4 gap-y-1 border-b border-hairline py-4 transition-colors sm:grid-cols-[3.5rem_1fr_14rem_5rem] sm:gap-6 sm:py-5"
>
  <span class="index text-concrete">{String(index).padStart(2, '0')}</span>
  <span
    class="text-[clamp(1.35rem,2.6vw,2.1rem)] leading-[1.05] tracking-[-0.035em] transition-opacity group-hover:opacity-50"
  >
    {title}
  </span>
  <span class="caption text-concrete hidden sm:block">{typology} — {location}</span>
  <span class="index text-concrete justify-self-end tabular-nums">{year}</span>
</a>
