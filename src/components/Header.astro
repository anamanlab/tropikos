---
import { SITE } from '@/site.config';
---

<header
  class="absolute inset-x-0 top-0 z-30 shell flex items-start justify-between gap-6 pt-[var(--header-y)]"
>
  <div class="flex items-start gap-[clamp(1.5rem,3.7vw,3.3125rem)]" aria-label="Hora local">
    <p class="caption flex items-baseline gap-1.5 tabular-nums">
      <span data-clock="rec">--:--:--</span>
      <span class="text-concrete">{SITE.cityCode}</span>
    </p>
    <p class="caption hidden items-baseline gap-1.5 tabular-nums sm:flex">
      <span data-clock="fen">--:--:--</span>
      <span class="text-concrete">{SITE.cityCodeAlt}</span>
    </p>
  </div>

  <button
    type="button"
    data-menu-trigger
    aria-expanded="false"
    aria-controls="menu-overlay"
    class="body-copy tap cursor-pointer px-1 -mx-1"
  >
    Menu
  </button>
</header>

<script>
  function tick() {
    const now = new Date();
    const zones: Record<string, string> = {
      rec: 'America/Recife',
      fen: 'America/Noronha',
    };
    for (const [key, zone] of Object.entries(zones)) {
      const els = document.querySelectorAll<HTMLElement>(`[data-clock="${key}"]`);
      if (!els.length) continue;
      const value = new Intl.DateTimeFormat('pt-BR', {
        timeZone: zone,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).format(now);
      els.forEach((el) => (el.textContent = value));
    }
  }

  tick();
  window.setInterval(tick, 1000);
</script>
