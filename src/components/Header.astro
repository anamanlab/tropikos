---
import Logo from '@/components/Logo.astro';
import { SITE } from '@/site.config';
---

<header
  class="absolute inset-x-0 top-0 z-30 shell grid grid-cols-[1fr_auto_1fr] items-center gap-3 pt-[var(--header-y)] sm:gap-6"
>
  <div class="flex items-start gap-[clamp(1rem,2.4vw,2rem)]" aria-label="Hora em Recife e Paris">
    <p class="caption flex items-baseline gap-1.5 tabular-nums">
      <span data-clock="rec" data-timezone={SITE.timezone}>--:--:--</span>
      <span class="text-concrete">{SITE.cityCode}</span>
    </p>
    <p class="caption hidden items-baseline gap-1.5 tabular-nums sm:flex">
      <span data-clock="par" data-timezone={SITE.timezoneAlt}>--:--:--</span>
      <span class="text-concrete" title="Paris">{SITE.cityCodeAlt}</span>
    </p>
  </div>

  <a
    href="/"
    aria-label="Trópikos Arquitetos — página inicial"
    class="justify-self-center transition-opacity hover:opacity-70"
  >
    <Logo
      variant="horizontal"
      color="color"
      class="hidden h-auto w-[180px] sm:block"
      decorative
    />
    <Logo variant="symbol" color="color" class="h-14 w-14 sm:hidden" decorative />
  </a>

  <button
    type="button"
    data-menu-trigger
    aria-expanded="false"
    aria-controls="menu-overlay"
    class="body-copy tap cursor-pointer justify-self-end px-1 -mx-1"
  >
    Menu
  </button>
</header>

<script>
  const clocks = Array.from(document.querySelectorAll<HTMLElement>('[data-clock]'));
  const formatters = new Map<string, Intl.DateTimeFormat>();

  for (const clock of clocks) {
    const zone = clock.dataset.timezone;
    if (!zone || formatters.has(zone)) continue;
    formatters.set(
      zone,
      new Intl.DateTimeFormat('pt-BR', {
        timeZone: zone,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }),
    );
  }

  function tick() {
    const now = new Date();
    for (const clock of clocks) {
      const formatter = formatters.get(clock.dataset.timezone ?? '');
      if (formatter) clock.textContent = formatter.format(now);
    }
  }

  tick();
  window.setInterval(tick, 1000);
</script>
