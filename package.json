{
  "name": "tropikos-arquitetos",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Trópikos Arquitetos — architecture and interiors in Recife, Brazil.",
  "keywords": [
    "architecture",
    "astro",
    "recife",
    "tropikos",
    "portfolio"
  ],
  "license": "UNLICENSED",
  "author": "Trópikos Arquitetos",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && node scripts/generate-agent-markdown.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "pnpm build && node --experimental-strip-types --test tests/*.test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "deploy": "pnpm build && cf deploy",
    "deploy:dry": "pnpm build && cf deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@google/developer-knowledge": "^0.10.0",
    "astro": "^7.3.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "cf": "1.0.0-beta.20",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  }
}
